# Normalize text files in the repository.
* text=auto

# Source, configuration, documentation, and scripts use LF.
*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf
*.py     text eol=lf
*.toml   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.cmake  text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
CMakeLists.txt text eol=lf

# Native Windows command files retain CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Common binary files must never undergo line-ending conversion.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.pdf    binary
*.elf    binary
*.bin    binary

# Repository metadata and lock files use LF.
.gitattributes text eol=lf
.gitignore     text eol=lf
uv.lock        text eol=lf
